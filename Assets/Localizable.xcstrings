      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你的许可"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不"
          }
        }
      }
    },
    "New session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话"
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        }
      }
    },
    "Niko Island Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Niko Island 设置"
          }
        }
      }
    },
    "Niko Island could not start listening": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Niko Island 无法开始监听"
          }
        }
      }
    },
    "No Coding Plan key has been added yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有添加 Coding Plan 的密钥。"
          }
        }
      }
    },
    "No agents found yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有发现代理"
          }
        }
      }
    },
    "No agents running yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有正在运行的代理。"
          }
        }
      }
    },
    "No analytics, no crash reports, no update checks. Events are kept in memory; the usage database holds numbers and identifiers only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有统计、没有崩溃上报、没有更新检查。事件只保存在内存里；用量数据库只存数字和标识符。"
          }
        }
      }
    },
    "No banner appears while the session's own terminal is in front.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当该会话所在的终端就在前台时，不会弹出横幅。"
          }
        }
      }
    },
    "No price known for: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下模型暂无价格：%@"
          }
        }
      }
    },
    "No sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有会话"
          }
        }
      }
    },
    "No supported agent was found in your home directory.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的主目录里没有找到受支持的代理。"
          }
        }
      }
    },
    "No usage found yet. Numbers appear after an agent has written a transcript on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有用量数据。代理在这台 Mac 上写下会话记录后，这里就会出现数字。"
          }
        }
      }
    },
    "No wait": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不等待"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不接入"
          }
        }
      }
    },
    "Nothing happens until you decide. The agent is waiting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你做出决定之前什么都不会发生，代理正在等待。"
          }
        }
      }
    },
    "Nothing is connected yet. Connecting changes nothing until you say so.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有接入任何代理。在你确认之前，接入不会改动任何东西。"
          }
        }
      }
    },
    "Notify me when": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些时候通知我"
          }
        }
      }
    },
    "Off by default. Each moment below can be switched on its own.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。下面每个时刻都可以单独开关。"
          }
        }
      }
    },
    "Off by default. It downloads a public list of prices and sends nothing about you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。它只下载一份公开的价格表，不会发送任何与你有关的信息。"
          }
        }
      }
    },
    "Off: a plain dot in each agent's colour.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后：每个代理显示为一个带颜色的圆点。"
          }
        }
      }
    },
    "Off: it appears only while there are sessions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，只有存在会话时它才会出现。"
          }
        }
      }
    },
    "One creature and a few words. It rests on your menu bar and leaves with it when an app goes full screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只小生物加几个字。它停在菜单栏上，应用进入全屏时随菜单栏一起离开。"
          }
        }
      }
    },
    "Open Niko Island at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开 Niko Island"
          }
        }
      }
    },
    "Open Releases Page": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开发布页面"
          }
        }
      }
    },
    "Open by itself when an agent needs a decision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理需要你决定时自动展开"
          }
        }
      }
    },
    "Open folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文件夹"
          }
        }
      }
    },
    "Open in Terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中打开"
          }
        }
      }
    },
    "Open the island with %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 打开小岛"
          }
        }
      }
    },
    "Open when the pointer rests on it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针停在上面时展开"
          }
        }
      }
    },
    "Opening and closing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开与收起"
          }
        }
      }
    },
    "Opens the download page in your browser.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开下载页面。"
          }
        }
