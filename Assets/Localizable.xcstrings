            "state": "translated",
            "value": "Pro 模型，每日"
          }
        }
      }
    },
    "Prompt tokens read from the cache, out of every prompt token, in these seven days.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这七天里，所有提示 token 中从缓存读取的比例。"
