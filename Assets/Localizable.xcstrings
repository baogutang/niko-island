    "Limits the provider keeps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "厂商那边的额度"
          }
        }
      }
    },
    "Long": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长"
          }
        }
      }
    },
    "Look": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Make it yours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调成你喜欢的样子"
          }
        }
      }
    },
    "Medium": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中"
          }
        }
      }
    },
    "Moments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时刻"
          }
        }
      }
    },
    "Mute sounds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
