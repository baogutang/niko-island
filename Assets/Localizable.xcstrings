{
  "sourceLanguage": "en",
  "strings": {
    "%@ has a question": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有一个问题"
          }
        }
      }
    },
    "%@ needs you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在等你"
          }
        }
      }
    },
    "%@ tokens": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens"
          }
        }
      }
    },
    "%@ wants to edit %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要编辑 %2$@"
          }
        }
      }
    },
    "%@ wants to fetch a URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要抓取一个网址"
          }
        }
      }
    },
    "%@ wants to read %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要读取 %2$@"
          }
        }
      }
    },
    "%@ wants to run a command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要运行一条命令"
          }
        }
      }
    },
    "%@ wants to search the project": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要搜索项目"
          }
        }
      }
    },
    "%@ wants to start a sub-agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要启动一个子代理"
          }
        }
      }
    },
    "%@ wants to use %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要使用 %2$@"
          }
        }
      }
    },
    "%lld helpers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个子代理"
          }
        }
      }
    },
    "%lld sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个会话"
          }
        }
      }
    },
    "%lld waiting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个在等待"
          }
        }
      }
    },
    "%lld waiting for your decision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项等待你决定"
          }
        }
      }
    },
    "+ %lld more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 项"
          }
        }
      }
    },
    "5-hour window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 小时窗口"
          }
        }
      }
    },
    "7-day window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天窗口"
          }
        }
      }
    },
    "8-bit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8-bit"
          }
        }
      }
    },
    "A permission request or a question is waiting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有权限请求或提问在等你处理。"
          }
        }
      }
    },
    "A rate-limit window passed 90%.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个速率限制窗口已用掉 90%。"
          }
        }
      }
    },
    "A redacted report you can attach to an issue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份已脱敏的报告，可以附在 Issue 里。"
          }
        }
      }
    },
    "A turn ended because something failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某一轮因为出错而结束。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理"
          }
        }
      }
    },
    "Agents keep working; waiting requests go back to their terminals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理会继续工作；等待中的请求会回到各自的终端。"
          }
        }
      }
    },
    "Allow all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部允许"
          }
        }
      }
    },
    "Allow every request for the rest of this session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话后续的所有请求都允许"
          }
        }
      }
    },
    "Allow once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许一次"
          }
        }
      }
    },
    "Allow this tool for the rest of the session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话后续都允许这个工具"
          }
        }
      }
    },
    "Always allow %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终允许 %@"
          }
        }
      }
    },
    "An agent asks a question": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理向我提问时"
          }
        }
      }
    },
    "An agent asks for permission": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理请求权限时"
          }
        }
      }
    },
    "An agent finished its turn.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成了这一轮。"
          }
        }
      }
    },
    "An agent finishes and waits for me": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成并等待我时"
          }
        }
      }
    },
    "An agent picked up your prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理接到了你的指令并开始工作。"
          }
        }
      }
    },
    "Answer here and the agent carries on with the session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里回答，代理就会继续当前会话。"
          }
        }
      }
    },
    "Answer in the terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到终端里回答"
          }
        }
      }
    },
    "Auto-approving everything this session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话正在自动批准所有请求"
          }
        }
      }
    },
    "Auto-approving: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在自动批准：%@"
          }
        }
      }
    },
    "Available in the installed app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在已安装的应用中可用。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "By model, last 7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按模型统计（最近 7 天）"
          }
        }
      }
    },
    "Choose any that apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可多选"
          }
        }
      }
    },
    "Claude rate limits": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 速率限制"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入"
          }
        }
      }
    },
    "Connect an agent…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入一个代理…"
          }
        }
      }
    },
    "Connecting adds entries tagged niko-bridge to the agent's config after a backup. Removing takes out only those entries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入时会先备份，再向代理的配置里添加带 niko-bridge 标记的条目；移除时只会删掉这些条目。"
          }
        }
      }
    },
    "Costs are estimates from public list prices; your plan or invoice may differ. Counted from transcripts on this Mac only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用按公开标价估算，可能与你的套餐或账单不同。仅统计这台 Mac 上的会话记录。"
          }
        }
      }
    },
    "Cues for each moment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个时刻配一声提示"
          }
        }
      }
    },
    "Decide in the agent's own prompt instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为在代理自己的提示里决定"
          }
        }
      }
    },
    "Decide in the terminal instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改到终端里决定"
          }
        }
      }
    },
    "Deny": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除卡片"
          }
        }
      }
    },
    "English and Simplified Chinese are included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置英文和简体中文。"
          }
        }
      }
    },
    "Everything stays on this Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都留在这台 Mac 上"
          }
        }
      }
    },
    "Export diagnostics": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出诊断信息"
          }
        }
      }
    },
    "Files and sound packs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件与音效包"
          }
        }
      }
    },
    "Finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        }
      }
    },
    "Finished and waiting for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成，正在等你"
          }
        }
      }
    },
    "Follows the system language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统语言"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "Has a question for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有问题需要你回答"
          }
        }
      }
    },
    "Hit an error": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错了"
          }
        }
      }
    },
    "Hooks and connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子与接入"
          }
        }
      }
    },
    "Hooks are not installed yet. Nothing is changed until you say so.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装钩子。在你确认之前不会改动任何东西。"
          }
        }
      }
    },
    "Hooks cannot start the bridge until the flag is cleared. Run this once in a terminal, then reopen the app:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在清除隔离标记之前，钩子无法启动桥接程序。请在终端里执行一次下面的命令，然后重新打开应用："
          }
        }
      }
    },
    "How it opens and closes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何展开与收起"
          }
        }
      }
    },
    "Island": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "岛屿"
          }
        }
      }
    },
    "Island and 8-bit are generated by the app itself; no audio files are bundled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“岛屿”和“8-bit”两套音效由应用自己合成，没有打包任何音频文件。"
          }
        }
      }
    },
    "It closes again when the pointer leaves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针离开后会自动收起。"
          }
        }
      }
    },
    "It never takes keyboard focus away from what you are typing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不会抢走你正在输入的键盘焦点。"
          }
        }
      }
    },
    "Keep the island visible when nothing is running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有会话时也保持岛屿可见"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Last 7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 7 天"
          }
        }
      }
    },
    "Limit close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额度告急"
          }
        }
      }
    },
    "Moments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时刻"
          }
        }
      }
    },
    "Mute sounds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音"
          }
        }
      }
    },
    "My files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的文件"
          }
        }
      }
    },
    "Needs you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你"
          }
        }
      }
    },
    "Needs your permission": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你的许可"
          }
        }
      }
    },
    "New session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新会话"
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        }
      }
    },
    "Niko Island Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Niko Island 设置"
          }
        }
      }
    },
    "Niko Island could not start listening": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Niko Island 无法开始监听"
          }
        }
      }
    },
    "No agents running yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有正在运行的代理。"
          }
        }
      }
    },
    "No analytics, no crash reports, no update checks. Events are kept in memory; the usage database holds numbers and identifiers only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有统计、没有崩溃上报、没有更新检查。事件只保存在内存里；用量数据库只存数字和标识符。"
          }
        }
      }
    },
    "No banner appears while the session's own terminal is in front.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当该会话所在的终端就在前台时，不会弹出横幅。"
          }
        }
      }
    },
    "No price known for: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下模型暂无价格：%@"
          }
        }
      }
    },
    "No sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有会话"
          }
        }
      }
    },
    "No supported agent was found in your home directory.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的主目录里没有找到受支持的代理。"
          }
        }
      }
    },
    "No usage found yet. Numbers appear after an agent has written a transcript on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有用量数据。代理在这台 Mac 上写下会话记录后，这里就会出现数字。"
          }
        }
      }
    },
    "Nothing happens until you decide. The agent is waiting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你做出决定之前什么都不会发生，代理正在等待。"
          }
        }
      }
    },
    "Notifications and startup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知与启动"
          }
        }
      }
    },
    "Notify me when": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些时候通知我"
          }
        }
      }
    },
    "Off by default. Each moment below can be switched on its own.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。下面每个时刻都可以单独开关。"
          }
        }
      }
    },
    "Off by default. It is the only network request this app can make; everything else stays on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
