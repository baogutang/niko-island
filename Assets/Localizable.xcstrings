{
  "sourceLanguage": "en",
  "strings": {
    "%@ has a question": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有一个问题"
          }
        }
      }
    },
    "%@ keeps the plan's limits on its own servers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 把套餐的额度记在它自己的服务器上。"
          }
        }
      }
    },
    "%@ needs you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在等你"
          }
        }
      }
    },
    "%@ open, with nothing happening in the last %lld minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已打开，最近 %lld 分钟内没有动静。"
          }
        }
      }
    },
    "%@ tokens": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens"
          }
        }
      }
    },
    "%@ wants to edit %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要编辑 %2$@"
          }
        }
      }
    },
    "%@ wants to fetch a URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要抓取一个网址"
          }
        }
      }
    },
    "%@ wants to read %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要读取 %2$@"
          }
        }
      }
    },
    "%@ wants to run a command": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要运行一条命令"
          }
        }
      }
    },
    "%@ wants to search the project": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要搜索项目"
          }
        }
      }
    },
    "%@ wants to start a sub-agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要启动一个子代理"
          }
        }
      }
    },
    "%@ wants to use %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想要使用 %2$@"
          }
        }
      }
    },
    "%@ was turned away": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 被限流拒绝了"
          }
        }
      }
    },
    "%lld agents on this Mac are not connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上有 %lld 个代理尚未接入"
          }
        }
      }
    },
    "%lld days ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天前"
          }
        }
      }
    },
    "%lld helpers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个子代理"
          }
        }
      }
    },
    "%lld min ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟前"
          }
        }
      }
    },
    "%lld resets left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还可重置 %lld 次"
          }
        }
      }
    },
    "%lld s": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "%lld sessions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个会话"
          }
        }
      }
    },
    "%lld waiting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个在等待"
          }
        }
      }
    },
    "%lld waiting for your decision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项等待你决定"
          }
        }
      }
    },
    "%lld-day limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天限额"
          }
        }
      }
    },
    "%lld-hour limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时限额"
          }
        }
      }
    },
    "%lldh %lldm ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时 %lld 分钟前"
          }
        }
      }
    },
    "+ %lld more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %lld 项"
          }
        }
      }
    },
    "10 min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 分钟"
          }
        }
      }
    },
    "2 hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 小时"
          }
        }
      }
    },
    "30 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天"
          }
        }
      }
    },
    "30 min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 分钟"
          }
        }
      }
    },
    "5 hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 小时"
          }
        }
      }
    },
    "5-hour limit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 小时限额"
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "8 hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8 小时"
          }
        }
      }
    },
    "8-bit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8-bit"
          }
        }
      }
    },
    "A key is saved in your Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥已保存在你的钥匙串里。"
          }
        }
      }
    },
    "A permission request or a question is waiting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有权限请求或提问在等你处理。"
          }
        }
      }
    },
    "A rate-limit window passed 90%.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个速率限制窗口已用掉 90%。"
          }
        }
      }
    },
    "A redacted report you can attach to an issue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份已脱敏的报告，可以附在 Issue 里。"
          }
        }
      }
    },
    "A reset is spent in %@ itself. This only brings it to the front.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置要在 %@ 里使用，这里只是把它带到前台。"
          }
        }
      }
    },
    "A short cue when an agent needs you or finishes. Generated by the app, off unless you want them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理需要你或完成时的一声提示。由应用自己合成，你不开就不会响。"
          }
        }
      }
    },
    "A turn ended because something failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某一轮因为出错而结束。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理"
          }
        }
      }
    },
    "Agents keep working; waiting requests go back to their terminals.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理会继续工作；等待中的请求会回到各自的终端。"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All quiet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切平静。"
          }
        }
      }
    },
    "Allow all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部允许"
          }
        }
      }
    },
    "Allow every request for the rest of this session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话后续的所有请求都允许"
          }
        }
      }
    },
    "Allow once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许一次"
          }
        }
      }
    },
    "Allow this tool for the rest of the session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话后续都允许这个工具"
          }
        }
      }
    },
    "Always allow %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终允许 %@"
          }
        }
      }
    },
    "Always show": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示"
          }
        }
      }
    },
    "An agent asks a question": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理向我提问时"
          }
        }
      }
    },
    "An agent asks for permission": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理请求权限时"
          }
        }
      }
    },
    "An agent finished its turn.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成了这一轮。"
          }
        }
      }
    },
    "An agent finishes and waits for me": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成并等待我时"
          }
        }
      }
    },
    "An agent picked up your prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理接到了你的指令并开始工作。"
          }
        }
      }
    },
    "An island at the top of your screen for the agents that write your code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕顶部的一座小岛，照看替你写代码的代理。"
          }
        }
      }
    },
    "Answer here and the agent carries on with the session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里回答，代理就会继续当前会话。"
          }
        }
      }
    },
    "Answer in the terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到终端里回答"
          }
        }
      }
    },
    "Answered. %lld windows known.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已获取，共 %lld 个额度窗口。"
          }
        }
      }
    },
    "Anthropic did not accept the sign-in.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic 没有接受这个登录凭据。"
          }
        }
      }
    },
    "App": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Ask Anthropic for my Claude limits": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Anthropic 查询我的 Claude 额度"
          }
        }
      }
    },
    "Ask BigModel / Z.ai for my GLM Coding Plan limits": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向智谱 BigModel / Z.ai 查询我的 GLM Coding Plan 额度"
          }
        }
      }
    },
    "Asking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查询…"
          }
        }
      }
    },
    "At once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立刻"
          }
        }
      }
    },
    "Auto-approving everything this session": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话正在自动批准所有请求"
          }
        }
      }
    },
    "Auto-approving: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在自动批准：%@"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic: the display with a camera housing, else the main one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：有摄像头挖孔的显示器优先，否则用主显示器。"
          }
        }
      }
    },
    "Automatic: the one ZCode is set to.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动：跟随 ZCode 当前的设置。"
          }
        }
      }
    },
    "Available in the installed app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在已安装的应用中可用。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        }
      }
    },
    "Back in one click": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键回去"
          }
        }
      }
    },
    "Brisk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利落"
          }
        }
      }
    },
    "By model, last 7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按模型统计（最近 7 天）"
          }
        }
      }
    },
    "Calm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "舒缓"
          }
        }
      }
    },
    "Check now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即查询"
          }
        }
      }
    },
    "Choose any that apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可多选"
          }
        }
      }
    },
    "Claude Code and Codex sessions show up even when they are idle, were started before this app, or run in a desktop app that is not connected. The logs are only read, on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使会话处于空闲、在本应用启动之前就已开始，或者运行在尚未接入的桌面端里，Claude Code 和 Codex 的会话也会显示。日志只在这台 Mac 上读取，不做任何修改。"
          }
        }
      }
    },
    "Claude Code has not signed in on this Mac, so there is nothing to ask with.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 还没有在这台 Mac 上登录，所以没有可用来查询的凭据。"
          }
        }
      }
    },
    "Claude Code's sign-in on this Mac has run out. It renews itself the next time Claude Code runs in a terminal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 在这台 Mac 上的登录已过期。下次在终端里运行 Claude Code 时它会自己续期。"
          }
        }
      }
    },
    "Click a session and its terminal tab or app comes forward. Sessions show up even for agents you have not connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下会话，对应的终端标签页或应用就回到前台。没有接入的代理，会话也会显示。"
          }
        }
      }
    },
    "Codex runs a new hook only after you trust it: type /hooks in Codex and trust the niko-bridge entries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 只有在你信任之后才会运行新的钩子：在 Codex 里输入 /hooks，信任带 niko-bridge 的条目。"
          }
        }
      }
    },
    "Colour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "Come in over a full-screen app when an agent needs a decision": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理需要你决定时，在全屏应用之上出现"
          }
        }
      }
    },
    "Compact": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入"
          }
        }
      }
    },
    "Connect %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入 %@…"
          }
        }
      }
    },
    "Connect %lld agents": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入 %lld 个代理"
          }
        }
      }
    },
    "Connect all": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部接入"
          }
        }
      }
    },
    "Connect an agent…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入一个代理…"
          }
        }
      }
    },
    "Connecting adds a few entries tagged niko-bridge to each agent's own config, after a backup. Nothing else is touched, and Settings takes them out again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入会先备份，再往各代理自己的配置里加几条带 niko-bridge 标记的条目。其他内容一概不动，在设置里可以随时移除。"
          }
        }
      }
    },
    "Connecting adds entries tagged niko-bridge to the agent's config after a backup. Removing takes out only those entries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入时会先备份，再向代理的配置里添加带 niko-bridge 标记的条目；移除时只会删掉这些条目。"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在接入…"
          }
        }
      }
    },
    "Connections and creatures": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入与小生物"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Costs are estimates from public list prices; your plan or invoice may differ. Counted from what the agents wrote on this Mac only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用是按公开标价估算的，可能与你的套餐或账单不同。仅统计各代理在这台 Mac 上写下的记录。"
          }
        }
      }
    },
    "Cues for each moment": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个时刻配一声提示"
          }
        }
      }
    },
    "Decide in place": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就地决定"
          }
        }
      }
    },
    "Decide in the agent's own prompt instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为在代理自己的提示里决定"
          }
        }
      }
    },
    "Decide in the terminal instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改到终端里决定"
